{
  "name": "Meeting to actions",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Meeting to actions",
        "formDescription": "Paste a meeting transcript. The workflow extracts the decisions and action items, logs the actions to a sheet, and sends the recap once a human approves it.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Meeting title",
              "requiredField": true
            },
            {
              "fieldLabel": "Meeting date",
              "fieldType": "date",
              "requiredField": true
            },
            {
              "fieldLabel": "Transcript",
              "fieldType": "textarea",
              "requiredField": true
            }
          ]
        },
        "options": {}
      },
      "id": "a1",
      "name": "Meeting transcript",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  system_instruction: { parts: [{ text: 'You turn meeting transcripts into structured output. Reply with JSON only. Schema: {\"summary\": string (3 sentences max), \"decisions\": [string], \"actions\": [{\"owner\": string, \"task\": string, \"due\": string}]}. An action needs a named owner from the transcript. If no due date is stated, write \"not stated\".' }] },\n  contents: [{ role: 'user', parts: [{ text: 'Meeting: ' + $json['Meeting title'] + ' (' + $json['Meeting date'] + ')\\n\\nTranscript:\\n' + $json['Transcript'] }] }],\n  generationConfig: { responseMimeType: 'application/json', temperature: 0.2 }\n}) }}",
        "options": {}
      },
      "id": "a2",
      "name": "Extract decisions and actions (Gemini)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Parse the model output and attach the meeting details.\nconst meeting = $('Meeting transcript').first().json;\nlet text = $input.first().json.candidates?.[0]?.content?.parts?.[0]?.text ?? '';\ntext = text.replace(/^```(?:json)?\\s*/i, '').replace(/```\\s*$/i, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(text);\n} catch (e) {\n  throw new Error('The model did not return valid JSON. Raw output: ' + text.slice(0, 300));\n}\n\nconst actions = (parsed.actions ?? []).map(a => ({\n  meeting: meeting['Meeting title'],\n  date: meeting['Meeting date'],\n  owner: a.owner ?? 'unassigned',\n  task: a.task ?? '',\n  due: a.due ?? 'not stated',\n  status: 'open',\n}));\n\nconst recapHtml = `\n<h2>${meeting['Meeting title']} (${meeting['Meeting date']})</h2>\n<p>${parsed.summary ?? ''}</p>\n<h3>Decisions</h3>\n<ul>${(parsed.decisions ?? []).map(d => `<li>${d}</li>`).join('')}</ul>\n<h3>Action items</h3>\n<ul>${actions.map(a => `<li><b>${a.owner}</b>: ${a.task} (due ${a.due})</li>`).join('')}</ul>`;\n\nreturn [{\n  json: {\n    meeting: meeting['Meeting title'],\n    date: meeting['Meeting date'],\n    summary: parsed.summary ?? '',\n    decisions: parsed.decisions ?? [],\n    actions,\n    actionCount: actions.length,\n    recapHtml,\n  }\n}];"
      },
      "id": "a3",
      "name": "Parse model output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        0
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "actions",
        "options": {}
      },
      "id": "a4",
      "name": "One item per action",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        780,
        -160
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_GOOGLE_SHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Actions"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "a5",
      "name": "Log actions to sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1040,
        -160
      ]
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "sendTo": "YOUR_EMAIL@example.com",
        "subject": "=Approve the recap: {{ $json.meeting }}",
        "message": "=The recap below goes to the team once you approve it.\n\n{{ $json.summary }}\n\nDecisions: {{ $json.decisions.join(' | ') }}\n\nAction items logged: {{ $json.actionCount }}",
        "approvalOptions": {
          "values": {
            "approvalType": "double"
          }
        },
        "options": {}
      },
      "id": "a6",
      "name": "Human approval",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        780,
        120
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.data.approved }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a7",
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1040,
        120
      ]
    },
    {
      "parameters": {
        "sendTo": "TEAM_LIST@example.com",
        "subject": "=Recap: {{ $('Parse model output').first().json.meeting }} ({{ $('Parse model output').first().json.date }})",
        "message": "={{ $('Parse model output').first().json.recapHtml }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "a8",
      "name": "Send recap to the team",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1300,
        40
      ]
    },
    {
      "parameters": {
        "sendTo": "YOUR_EMAIL@example.com",
        "subject": "=Recap not sent: {{ $('Parse model output').first().json.meeting }}",
        "message": "You declined the recap, so nothing went to the team. The action items are still in the sheet, edit them there and re-run if needed.",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "a9",
      "name": "Tell the owner it was declined",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1300,
        220
      ]
    }
  ],
