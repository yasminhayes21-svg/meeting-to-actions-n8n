{
  "name": "Meeting to actions",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Meeting to actions",
        "formDescription": "Paste a meeting transcript. Gemini extracts the decisions and action items, you review them, and only approved actions are saved to the meeting_actions data table.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Meeting title",
              "requiredField": true
            },
            {
              "fieldLabel": "Meeting date",
              "fieldType": "date",
              "requiredField": true
            },
            {
              "fieldLabel": "Transcript",
              "fieldType": "textarea",
              "requiredField": true
            }
          ]
        },
        "options": {}
      },
      "name": "Meeting transcript",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ],
      "webhookId": "meeting-to-actions"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  system_instruction: { parts: [{ text: 'You turn meeting transcripts into structured output. Reply with JSON only. Schema: {\"summary\": string (3 sentences max), \"decisions\": [string], \"actions\": [{\"owner\": string, \"task\": string, \"due\": string}]}. An action needs a named owner from the transcript. If no due date is stated, write \"not stated\".' }] },\n  contents: [{ role: 'user', parts: [{ text: 'Meeting: ' + $json['Meeting title'] + ' (' + $json['Meeting date'] + ')\\n\\nTranscript:\\n' + $json['Transcript'] }] }],\n  generationConfig: { responseMimeType: 'application/json', temperature: 0.2 }\n}) }}",
        "options": {}
      },
      "name": "Extract decisions and actions (Gemini)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Parse the model output and attach the meeting details.\nconst meeting = $('Meeting transcript').first().json;\nlet text = $input.first().json.candidates?.[0]?.content?.parts?.[0]?.text ?? '';\ntext = text.replace(/^```(?:json)?\\s*/i, '').replace(/```\\s*$/i, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(text);\n} catch (e) {\n  throw new Error('The model did not return valid JSON. Raw output: ' + text.slice(0, 300));\n}\n\n// Model output is shown on a web page, so escape it.\nconst esc = s => String(s ?? '').replace(/[&<>\"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\n\nconst actions = (parsed.actions ?? []).map(a => ({\n  meeting: String(meeting['Meeting title'] ?? ''),\n  date: String(meeting['Meeting date'] ?? ''),\n  owner: String(a.owner ?? 'unassigned'),\n  task: String(a.task ?? ''),\n  due: String(a.due ?? 'not stated'),\n  status: 'open',\n}));\nconst decisions = (parsed.decisions ?? []).map(String);\n\nconst recapHtml = `\n<h3>${esc(meeting['Meeting title'])} (${esc(meeting['Meeting date'])})</h3>\n<p>${esc(parsed.summary)}</p>\n<h4>Decisions</h4>\n<ul>${decisions.map(d => `<li>${esc(d)}</li>`).join('') || '<li>none</li>'}</ul>\n<h4>Action items</h4>\n<ul>${actions.map(a => `<li><b>${esc(a.owner)}</b>: ${esc(a.task)} (due ${esc(a.due)})</li>`).join('') || '<li>none</li>'}</ul>`;\n\nreturn [{\n  json: {\n    meeting: meeting['Meeting title'],\n    date: meeting['Meeting date'],\n    summary: parsed.summary ?? '',\n    decisions,\n    actions,\n    actionCount: actions.length,\n    recapHtml,\n  }\n}];"
      },
      "name": "Parse model output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "name": "Review and approve",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.5,
      "position": [
        720,
        0
      ],
      "webhookId": "review-and-approve",
      "parameters": {
        "operation": "page",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Extracted from the transcript",
              "fieldType": "html",
              "html": "={{ $json.recapHtml }}"
            },
            {
              "fieldLabel": "Decision",
              "fieldType": "radio",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Approve and save the actions"
                  },
                  {
                    "option": "Decline, save nothing"
                  }
                ]
              },
              "requiredField": true
            }
          ]
        },
        "options": {
          "formTitle": "Review before anything is saved",
          "formDescription": "A person decides. Nothing is saved until you approve.",
          "buttonLabel": "Submit decision"
        }
      }
    },
    {
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.Decision }}",
              "rightValue": "Approve and save the actions",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "Create the table if missing",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1200,
        -120
      ],
      "parameters": {
        "resource": "table",
        "operation": "create",
        "tableName": "meeting_actions",
        "columns": {
          "column": [
            {
              "name": "meeting",
              "type": "string"
            },
            {
              "name": "date",
              "type": "string"
            },
            {
              "name": "owner",
              "type": "string"
            },
            {
              "name": "task",
              "type": "string"
            },
            {
              "name": "due",
              "type": "string"
            },
            {
              "name": "status",
              "type": "string"
            }
          ]
        },
        "options": {
          "createIfNotExists": true
        }
      }
    },
    {
      "name": "One item per action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        -120
      ],
      "parameters": {
        "jsCode": "// One item per approved action, ready for the data table.\nreturn $('Parse model output').first().json.actions.map(a => ({ json: a }));"
      }
    },
    {
      "name": "Save actions",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1680,
        -120
      ],
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "meeting_actions"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      }
    },
    {
      "name": "Show the recap",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.5,
      "position": [
        1920,
        -120
      ],
      "webhookId": "show-the-recap",
      "executeOnce": true,
      "parameters": {
        "operation": "completion",
        "respondWith": "showText",
        "responseText": "={{ '<h2>Approved</h2><p>' + $('Parse model output').first().json.actionCount + ' action items saved to the meeting_actions data table.</p>' + $('Parse model output').first().json.recapHtml }}"
      }
    },
    {
      "name": "Declined",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.5,
      "position": [
        1200,
        120
      ],
      "webhookId": "declined",
      "parameters": {
        "operation": "completion",
        "respondWith": "text",
        "completionTitle": "Declined",
        "completionMessage": "Nothing was saved. Edit the transcript and run it again if needed."
      }
    }
  ],
